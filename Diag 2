// ---------- Q5 — RECONC grain test: are detail lines additive or cumulative? ---------
// Detail = none of the three total/subtotal flags. Compared with the total line of the
// same AuthorisationId on the latest date. (Supersedes the version sent earlier.)
EVALUATE
VAR _d = MAX ( FACT_RECONC[SnapshotDate] )
VAR _a =
    ADDCOLUMNS (
        CALCULATETABLE (
            VALUES ( FACT_RECONC[AuthorisationId] ),
            FACT_RECONC[SnapshotDate] = _d,
            FACT_RECONC[IsEnvelopeTotal] = FALSE (), FACT_RECONC[IsSubTotalUE] = FALSE (), FACT_RECONC[IsSubTotalPr] = FALSE ()
        ),
        "D_Lines", CALCULATE ( COUNTROWS ( FACT_RECONC ),
                       FACT_RECONC[SnapshotDate] = _d,
                       FACT_RECONC[IsEnvelopeTotal] = FALSE (), FACT_RECONC[IsSubTotalUE] = FALSE (), FACT_RECONC[IsSubTotalPr] = FALSE () ),
        "D_Sum",   CALCULATE ( SUM ( FACT_RECONC[AuthoEUR] ),
                       FACT_RECONC[SnapshotDate] = _d,
                       FACT_RECONC[IsEnvelopeTotal] = FALSE (), FACT_RECONC[IsSubTotalUE] = FALSE (), FACT_RECONC[IsSubTotalPr] = FALSE () ),
        "D_Max",   CALCULATE ( MAX ( FACT_RECONC[AuthoEUR] ),
                       FACT_RECONC[SnapshotDate] = _d,
                       FACT_RECONC[IsEnvelopeTotal] = FALSE (), FACT_RECONC[IsSubTotalUE] = FALSE (), FACT_RECONC[IsSubTotalPr] = FALSE () ),
        "D_Detail", CALCULATE (
                       CONCATENATEX ( FACT_RECONC,
                           FACT_RECONC[TenorQuantite] & FACT_RECONC[TenorUnite] & "=" & FORMAT ( FACT_RECONC[AuthoEUR], "#,0" ), " | " ),
                       FACT_RECONC[SnapshotDate] = _d,
                       FACT_RECONC[IsEnvelopeTotal] = FALSE (), FACT_RECONC[IsSubTotalUE] = FALSE (), FACT_RECONC[IsSubTotalPr] = FALSE () ),
        "T_Lines", CALCULATE ( COUNTROWS ( FACT_RECONC ), FACT_RECONC[SnapshotDate] = _d, FACT_RECONC[IsEnvelopeTotal] = TRUE () ),
        "T_Amt",   CALCULATE ( MAX ( FACT_RECONC[AuthoEUR] ), FACT_RECONC[SnapshotDate] = _d, FACT_RECONC[IsEnvelopeTotal] = TRUE () )
    )
RETURN
    TOPN (
        40,
        ADDCOLUMNS (
            FILTER ( _a, [D_Lines] >= 2 ),
            "Verdict",
                SWITCH (
                    TRUE (),
                    ISBLANK ( [T_Amt] ),              "NO TOTAL LINE ON THIS AUTH ID",
                    ABS ( [D_Sum] - [T_Amt] ) < 1,    "ADDITIVE",
                    ABS ( [D_Max] - [T_Amt] ) < 1,    "CUMULATIVE (total = max)",
                    "NEITHER - inspect"
                )
        ),
        [D_Lines], DESC
    )


// ---------- Q6 — RECONC amount scale & sign consistency, both sides ------------------
// AuthoEUR/UtilEUR go through fnParseZeroPad; DiffEUR goes through Number.From()/100.
// If both paths scale the same way, Match_AminusU (or Match_UminusA) ~= Checked.
// Match_abs high but the signed ones low => a sign is being stripped somewhere.
// Nothing matching => the two paths use different scales (the 100x trap).
EVALUATE
ROW (
    "C_Checked",       COUNTROWS ( FILTER ( FACT_RECONC, NOT ISBLANK ( FACT_RECONC[DiffEUR] ) ) ),
    "C_Match_AminusU", COUNTROWS ( FILTER ( FACT_RECONC, NOT ISBLANK ( FACT_RECONC[DiffEUR] ) && ABS ( FACT_RECONC[AuthoEUR] - FACT_RECONC[UtilEUR] - FACT_RECONC[DiffEUR] ) <= 1 ) ),
    "C_Match_UminusA", COUNTROWS ( FILTER ( FACT_RECONC, NOT ISBLANK ( FACT_RECONC[DiffEUR] ) && ABS ( FACT_RECONC[UtilEUR] - FACT_RECONC[AuthoEUR] - FACT_RECONC[DiffEUR] ) <= 1 ) ),
    "C_Match_abs",     COUNTROWS ( FILTER ( FACT_RECONC, NOT ISBLANK ( FACT_RECONC[DiffEUR] ) && ABS ( ABS ( FACT_RECONC[AuthoEUR] - FACT_RECONC[UtilEUR] ) - ABS ( FACT_RECONC[DiffEUR] ) ) <= 1 ) ),
    "C_NegDiff",       COUNTROWS ( FILTER ( FACT_RECONC, FACT_RECONC[DiffEUR] < 0 ) ),
    "C_MaxAutho",      MAX ( FACT_RECONC[AuthoEUR] ),
    "H_Checked",       COUNTROWS ( FILTER ( FACT_RECONC_HIST, NOT ISBLANK ( FACT_RECONC_HIST[DiffEUR] ) ) ),
    "H_Match_AminusU", COUNTROWS ( FILTER ( FACT_RECONC_HIST, NOT ISBLANK ( FACT_RECONC_HIST[DiffEUR] ) && ABS ( FACT_RECONC_HIST[AuthoEUR] - FACT_RECONC_HIST[UtilEUR] - FACT_RECONC_HIST[DiffEUR] ) <= 1 ) ),
    "H_Match_UminusA", COUNTROWS ( FILTER ( FACT_RECONC_HIST, NOT ISBLANK ( FACT_RECONC_HIST[DiffEUR] ) && ABS ( FACT_RECONC_HIST[UtilEUR] - FACT_RECONC_HIST[AuthoEUR] - FACT_RECONC_HIST[DiffEUR] ) <= 1 ) ),
    "H_Match_abs",     COUNTROWS ( FILTER ( FACT_RECONC_HIST, NOT ISBLANK ( FACT_RECONC_HIST[DiffEUR] ) && ABS ( ABS ( FACT_RECONC_HIST[AuthoEUR] - FACT_RECONC_HIST[UtilEUR] ) - ABS ( FACT_RECONC_HIST[DiffEUR] ) ) <= 1 ) ),
    "H_NegDiff",       COUNTROWS ( FILTER ( FACT_RECONC_HIST, FACT_RECONC_HIST[DiffEUR] < 0 ) ),
    "H_MaxAutho",      MAX ( FACT_RECONC_HIST[AuthoEUR] )
