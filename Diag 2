
// ---------- R1 — RECONC HIST: how big is the "second date" in each file? -------------
// Every HIST file spans 2 dates (Q7). If the later date is the NEXT file's date, that
// date holds rows from two files. This sizes it.
EVALUATE
VAR _t =
    ADDCOLUMNS (
        VALUES ( FACT_RECONC_HIST[SourceFile] ),
        "D1",   CALCULATE ( MIN ( FACT_RECONC_HIST[SnapshotDate] ) ),
        "D2",   CALCULATE ( MAX ( FACT_RECONC_HIST[SnapshotDate] ) ),
        "Rows", CALCULATE ( COUNTROWS ( FACT_RECONC_HIST ) )
    )
VAR _u =
    ADDCOLUMNS (
        _t,
        "Rows_D2",
            VAR _f = FACT_RECONC_HIST[SourceFile]
            VAR _d = [D2]
            RETURN CALCULATE ( COUNTROWS ( FACT_RECONC_HIST ),
                       FACT_RECONC_HIST[SourceFile] = _f, FACT_RECONC_HIST[SnapshotDate] = _d ),
        "Tot_D2",
            VAR _f = FACT_RECONC_HIST[SourceFile]
            VAR _d = [D2]
            RETURN CALCULATE ( COUNTROWS ( FACT_RECONC_HIST ),
                       FACT_RECONC_HIST[SourceFile] = _f, FACT_RECONC_HIST[SnapshotDate] = _d,
                       FACT_RECONC_HIST[IsEnvelopeTotal] = TRUE () ),
        "GapDays", INT ( [D2] - [D1] )
    )
RETURN
    ROW (
        "Files",                    COUNTROWS ( _u ),
        "Rows",                     SUMX ( _u, [Rows] ),
        "Rows_on_later_date",       SUMX ( _u, [Rows_D2] ),
        "TotalLines_on_later_date", SUMX ( _u, [Tot_D2] ),
        "Min_Rows_D2",              MINX ( _u, [Rows_D2] ),
        "Max_Rows_D2",              MAXX ( _u, [Rows_D2] ),
        "Gap_1day",                 COUNTROWS ( FILTER ( _u, [GapDays] = 1 ) ),
        "Gap_gt1",                  COUNTROWS ( FILTER ( _u, [GapDays] > 1 ) ),
        "D2_is_another_files_D1",   COUNTROWS ( FILTER ( _u, VAR _d = [D2] RETURN COUNTROWS ( FILTER ( _t, [D1] = _d ) ) > 0 ) )
    )


// ---------- R2 — RECONC current: which date has two files? (183 files, 182 dates) ---
EVALUATE
FILTER (
    ADDCOLUMNS (
        VALUES ( FACT_RECONC[SnapshotDate] ),
        "Files", CALCULATE ( DISTINCTCOUNT ( FACT_RECONC[SourceFile] ) ),
        "Rows",  CALCULATE ( COUNTROWS ( FACT_RECONC ) ),
        "Names", CALCULATE ( CONCATENATEX ( VALUES ( FACT_RECONC[SourceFile] ), FACT_RECONC[SourceFile], " | " ) )
    ),
    [Files] > 1
)


