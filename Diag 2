// ---------- M1 — chk_16A_HIST: columns present + entity (OBE) content per Parquet file --
// Why: 16A_HIST keeps rows where OBE is null ("[OBE] = null or ..."); the current query
// keeps only "E1010001". And 16A_HIST's MasterColumns omits SGCType / CPHGroupName /
// ControleZone. This shows whether those three exist in the Parquet at all, and how many
// history rows have a blank or non-CA-CIB entity.
let
    Src = Folder.Files("G:\_CCC_Data\BMT16A\Historical - Parquet"),
    Pq  = Table.SelectRows(Src, each [Extension] = ".parquet"),
    Chk = Table.AddColumn(Pq, "R", each
        let
            t    = Parquet.Document([Content]),
            cols = Table.ColumnNames(t),
            obe  = if List.Contains(cols, "OBE") then Table.Column(t, "OBE") else {}
        in
            [
                Has_SGCType      = List.Contains(cols, "SGCType"),
                Has_CPHGroupName = List.Contains(cols, "CPHGroupName"),
                Has_ControleZone = List.Contains(cols, "ControleZone"),
                Has_OBE          = List.Contains(cols, "OBE"),
                Rows             = Table.RowCount(t),
                OBE_Blank        = List.Count(List.Select(obe, each _ = null or _ = "")),
                OBE_NonCACIB     = List.Count(List.Select(obe, each _ <> null and _ <> "" and _ <> "E1010001"))
            ]),
    Out = Table.ExpandRecordColumn(
            Table.SelectColumns(Chk, {"Name", "R"}), "R",
            {"Has_SGCType", "Has_CPHGroupName", "Has_ControleZone", "Has_OBE", "Rows", "OBE_Blank", "OBE_NonCACIB"})
in
    Out


// ---------- M2 — chk_RECONC_HIST: Parquet column TYPES for the fragile columns ----------
// Why: the HIST query compares ValidityDate / flags with text ("" and "Y") and runs
// Text.Start on ValidityDate. If the bake stored any of these as numbers or booleans,
// the comparison is silently false / the parse silently null. Also shows whether the
// Parquet carries its own SnapshotDate (the HIST query prefers it if present), and which
// spelling of the bride-util column exists (UTil vs Util). "MISSING" = column not there.
let
    Src = Folder.Files("G:\_CCC_Data\repo\RECONC\Historical - Parquet"),
    Pq  = Table.SelectRows(Src, each [Extension] = ".parquet"),
    Chk = Table.AddColumn(Pq, "R", each
        let
            s   = Table.Schema(Parquet.Document([Content])),
            typ = (c as text) =>
                    let r = Table.SelectRows(s, each [Name] = c)
                    in  if Table.IsEmpty(r) then "MISSING" else r{0}[TypeName]
        in
            [
                SnapshotDate           = typ("SnapshotDate"),
                ContextId              = typ("ContextId"),
                ValidityDate           = typ("ValidityDate"),
                IsLigneTotal           = typ("IsLigneTotal"),
                IMntDepasse            = typ("IMntDepasse"),
                ConvertMontantAuthoEUR = typ("ConvertMontantAuthoEUR"),
                ConvertMontantDiffEUR  = typ("ConvertMontantDiffEUR"),
                ConvertBrideUTilEUR    = typ("ConvertBrideUTilEUR"),
