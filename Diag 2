// populated on every row. This isolates the total lines (the committee grain).
EVALUATE
ROW (
    "C_Tot",          COUNTROWS ( FILTER ( FACT_RECONC, FACT_RECONC[IsEnvelopeTotal] ) ),
    "C_Tot_DiffBlank",COUNTROWS ( FILTER ( FACT_RECONC, FACT_RECONC[IsEnvelopeTotal] && ISBLANK ( FACT_RECONC[DiffEUR] ) ) ),
    "C_Tot_Match",    COUNTROWS ( FILTER ( FACT_RECONC, FACT_RECONC[IsEnvelopeTotal] && NOT ISBLANK ( FACT_RECONC[DiffEUR] )
                          && ABS ( FACT_RECONC[AuthoEUR] - FACT_RECONC[UtilEUR] - FACT_RECONC[DiffEUR] ) <= 1 ) ),
    "C_Tot_DiffZero", COUNTROWS ( FILTER ( FACT_RECONC, FACT_RECONC[IsEnvelopeTotal] && FACT_RECONC[DiffEUR] = 0 && NOT ISBLANK ( FACT_RECONC[DiffEUR] ) ) ),
    "C_Det_DiffBlank",COUNTROWS ( FILTER ( FACT_RECONC, NOT FACT_RECONC[IsEnvelopeTotal] && NOT FACT_RECONC[IsSubTotalUE] && NOT FACT_RECONC[IsSubTotalPr]
                          && ISBLANK ( FACT_RECONC[DiffEUR] ) ) ),
    "H_Tot",          COUNTROWS ( FILTER ( FACT_RECONC_HIST, FACT_RECONC_HIST[IsEnvelopeTotal] ) ),
    "H_Tot_DiffBlank",COUNTROWS ( FILTER ( FACT_RECONC_HIST, FACT_RECONC_HIST[IsEnvelopeTotal] && ISBLANK ( FACT_RECONC_HIST[DiffEUR] ) ) ),
    "H_Tot_Match",    COUNTROWS ( FILTER ( FACT_RECONC_HIST, FACT_RECONC_HIST[IsEnvelopeTotal] && NOT ISBLANK ( FACT_RECONC_HIST[DiffEUR] )
                          && ABS ( FACT_RECONC_HIST[AuthoEUR] - FACT_RECONC_HIST[UtilEUR] - FACT_RECONC_HIST[DiffEUR] ) <= 1 ) ),
    "H_Tot_DiffZero", COUNTROWS ( FILTER ( FACT_RECONC_HIST, FACT_RECONC_HIST[IsEnvelopeTotal] && FACT_RECONC_HIST[DiffEUR] = 0 && NOT ISBLANK ( FACT_RECONC_HIST[DiffEUR] ) ) ),
    "H_Det_DiffZero", COUNTROWS ( FILTER ( FACT_RECONC_HIST, NOT FACT_RECONC_HIST[IsEnvelopeTotal] && NOT FACT_RECONC_HIST[IsSubTotalUE] && NOT FACT_RECONC_HIST[IsSubTotalPr]
