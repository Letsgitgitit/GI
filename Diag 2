RETURN
    ROW (
        "Blank_Util",           COUNTROWS ( _b ),
        "Avail_eq_Amount",      COUNTROWS ( FILTER ( _b, FACT_LIMIT_06[Available] = FACT_LIMIT_06[Amount] ) ),
