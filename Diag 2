// ---------- R5 — 06 envelopes: does every member row repeat the envelope Amount/Util? -
// Q8 showed auth 97859 / group 167038: ~150 CPYs, each row Amount 4bn, Util 360.8m,
// UtilCPY = that CPY's own share. If that holds model-wide, any SUM(Amount) or
// SUM(Utilisation) over 06 rows counts each envelope once per member.
EVALUATE
VAR _d = MAX ( FACT_LIMIT_06[SnapshotDate] )
RETURN
    ADDCOLUMNS (
        CALCULATETABLE ( VALUES ( FACT_LIMIT_06[AuthorisationId] ),
            FACT_LIMIT_06[SnapshotDate] = _d, FACT_LIMIT_06[StructureType] = "Envelope" ),
        "Grp",         CALCULATE ( MAX ( FACT_LIMIT_06[RicosIdRegroup] ), FACT_LIMIT_06[SnapshotDate] = _d ),
        "Grps",        CALCULATE ( DISTINCTCOUNT ( FACT_LIMIT_06[RicosIdRegroup] ), FACT_LIMIT_06[SnapshotDate] = _d ),
        "Members",     CALCULATE ( DISTINCTCOUNT ( FACT_LIMIT_06[HeadOfficeSirisId] ), FACT_LIMIT_06[SnapshotDate] = _d ),
        "Rows",        CALCULATE ( COUNTROWS ( FACT_LIMIT_06 ), FACT_LIMIT_06[SnapshotDate] = _d ),
        "Rows_UtilCPY0", CALCULATE ( COUNTROWS ( FACT_LIMIT_06 ), FACT_LIMIT_06[SnapshotDate] = _d, FACT_LIMIT_06[StructureType] <> "Envelope" ),
        "Amt_Min",     CALCULATE ( MIN ( FACT_LIMIT_06[Amount] ), FACT_LIMIT_06[SnapshotDate] = _d ),
        "Amt_Max",     CALCULATE ( MAX ( FACT_LIMIT_06[Amount] ), FACT_LIMIT_06[SnapshotDate] = _d ),
        "Util_Min",    CALCULATE ( MIN ( FACT_LIMIT_06[Utilisation] ), FACT_LIMIT_06[SnapshotDate] = _d ),
        "Util_Max",    CALCULATE ( MAX ( FACT_LIMIT_06[Utilisation] ), FACT_LIMIT_06[SnapshotDate] = _d ),
        "Sum_UtilCPY", CALCULATE ( SUM ( FACT_LIMIT_06[UtilCPY] ), FACT_LIMIT_06[SnapshotDate] = _d ),
        "Sum_Util",    CALCULATE ( SUM ( FACT_LIMIT_06[Utilisation] ), FACT_LIMIT_06[SnapshotDate] = _d )
    )
ORDER BY [Members] DESC
// Rows_UtilCPY0 > 0 => some rows on an envelope authorisation are NOT tagged "Envelope"
// (UtilCPY empty/0 for a member) => the UtilCPY<>0 signal misses members.


